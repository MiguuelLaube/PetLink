rules_version = '2';

// Cada pessoa só grava na própria pasta: {tipo}/{uid}/arquivo.
// Quem pode CRIAR/EDITAR um pet (e apontar para a foto) é decidido pelas regras do Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024;
    }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Fotos de pets e logos de ONG: leitura pública.
    match /pets/{uid}/{file} {
      allow read: if true;
      allow create: if owner(uid) && isImage();
      allow delete: if owner(uid);
    }
    match /ongs/{uid}/{file} {
      allow read: if true;
      allow create: if owner(uid) && isImage();
    }

    // Fotos de resgate: visíveis para quem está logado (as ONGs).
    match /foster/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if owner(uid) && isImage();
    }
  }
}
