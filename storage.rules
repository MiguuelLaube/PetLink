rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function me() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isImage() {
      return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024;
    }

    // Fotos de pets e logo da ONG: só a ONG dona escreve.
    match /pets/{ongId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && me().role == 'ong' && me().ongId == ongId && isImage();
      allow delete: if signedIn() && me().role == 'ong' && me().ongId == ongId;
    }
    match /ongs/{ongId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && me().role == 'ong' && me().ongId == ongId && isImage();
    }

    // Fotos de resgate enviadas pelo usuário.
    match /foster/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && isImage();
    }

    // Conteúdo do admin (notícias, parceiros, histórias).
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && me().role == 'admin' && isImage();
    }
  }
}
